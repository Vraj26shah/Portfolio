# Gmail credentials for the contact form's serverless function (api/contact.ts).
# These are server-side only — never exposed to the browser — so they do NOT use
# the VITE_ prefix and are read via process.env, not import.meta.env.
#
# Setup:
#   1. Turn on 2-Step Verification on the Gmail account you want to send from:
#      https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#      Choose "Mail" as the app (or "Other", name it "Portfolio contact form").
#      Google gives you a 16-character password — that's GMAIL_APP_PASSWORD below.
#      (This is NOT your normal Gmail password, and 2-Step Verification must be on
#      first or the App Passwords page won't appear.)
#   3. Fill in both values below.
#
# Local development:
#   A plain `npm run dev` (Vite) does not run /api functions. To test the contact
#   form locally, use the Vercel CLI instead: `npm i -g vercel`, `vercel link` once,
#   then `vercel dev`. Otherwise just test after deploying to Vercel.
#
# Production (Vercel):
#   Add both variables in the Vercel dashboard under
#   Project Settings -> Environment Variables, then redeploy.

GMAIL_USER=
GMAIL_APP_PASSWORD=
